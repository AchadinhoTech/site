<body>
<header>
  <a class="logo" href="#/"><img class="av" id="av" alt="" width="40" height="40"> Achadinhos da Tech</a>
  <nav id="nav"></nav>
</header>
<main id="app"></main>
<footer>Feito com 💗 por Achadinhos da Tech · Os links de compra levam à loja parceira</footer>
<button id="theme" aria-label="Alternar tema claro/escuro">🌙</button>
<script>
  // ====== EDITE AQUI: páginas e produtos ======
  // Cada página tem: título, descrição, emoji, cor do fundo dos cards e lista de produtos.
  // Troque "link" pelo link real de cada produto.
  const MM="https://s.shopee.com.br/";
  const LOGO="data:image/png;base64,", AV="data:image/png;base64,";
  const IMG={mouse:"data:image/jpeg;base64,",mousepad:"data:image/jpeg;base64,",keycaps:"data:image/jpeg;base64,",gato:"data:image/jpeg;base64,",gatoOculos:"data:image/jpeg;base64,"};
  const PAGES = {
    "setup-fofo": {
      nav:"Setup fofo", emoji:"🧸", color:"#ffd1e5",
      title:"Setup fofo", desc:"Mesa rosinha, gatinhos e teclado colorido: tudo para deixar seu cantinho com cara de sonho.",
      items:[
        ["Mousepad fofo","🖱️","R$ 29,99 – R$ 36,99",MM+"qk2NRX32u",IMG.mousepad],
        ["Keycaps para teclado","⌨️","R$ 11,73 – R$ 17,23",MM+"AUuXtPmfMF",IMG.keycaps],
        ["Suporte de gatinho para headset","🐱","R$ 34,94 – R$ 56,35",MM+"8fStiBTwVE",IMG.gato],
        ["Suporte de gatinho para headset e óculos","😺","R$ 62,93",MM+"2gBgZBGi2O",IMG.gatoOculos]]
    },
    "setup-my-melody": {
      nav:"Setup My Melody", emoji:"🐰", color:"#e6dcff",
      title:"Setup My Melody", desc:"Achadinhos nas cores rosa e lilás para quem ama o universo My Melody.",
      items:[]
    },
    "gadgets-nerd": {
      nav:"Gadgets nerd", emoji:"🎧", color:"#c9f3e6",
      title:"Gadgets nerd", desc:"Tecnologia com personalidade para o seu setup.",
      items:[
        ["Mouse","🖲️","R$ 40,91",MM+"3g4Dkgd7ca",IMG.mouse]]
    }
  };
  // ============================================
  const $app=document.getElementById('app'), $nav=document.getElementById('nav');
  const keys=Object.keys(PAGES);
  const favs=new Set();
  try{JSON.parse(localStorage.getItem('fav')||'[]').forEach(x=>favs.add(x))}catch(e){}
  const saveFavs=()=>{try{localStorage.setItem('fav',JSON.stringify([...favs]))}catch(e){}};
  const ALL=keys.flatMap(k=>PAGES[k].items.map(i=>({i,c:PAGES[k].color})));
  const esc=s=>String(s).replace(/"/g,'&quot;');
  function navHtml(cur){
    return `<a href="#/" class="${cur==='home'?'on':''}">Início</a>`+
            keys.map(k=>`<a href="#/${k}" class="${cur===k?'on':''}">${PAGES[k].nav}</a>`).join('')+
            `<a href="#/favoritos" class="${cur==='favoritos'?'on':''}">💗 Favoritos <b id="fc">${favs.size}</b></a><a href="#/sobre" class="${cur==='sobre'?'on':''}">Sobre</a>`;
  }
  function card(i,color){
    const on=favs.has(i[3]);
    return `<article class="prod"><div class="thumb" style="background:${color}">${i[4]?`<img src="${i[4]}" alt="${esc(i[0])}">`:i[1]}<button class="fav${on?' on':''}" data-id="${i[3]}" aria-label="Favoritar ${esc(i[0])}" aria-pressed="${on}">${on?'💗':'🤍'}</button></div><div class="b"><h3>${i[0]}</h3><span class="price">${i[2]}</span><a class="btn" href="${i[3]}" target="_blank" rel="noopener noreferrer">Ver na Shopee</a></div></article>`;
  }
  function home(){
    return `<section class="hero"><div class="stage"><div class="bubble" id="bub" aria-live="polite">Miau! Clique em mim 🐾</div>
  <button class="mascot" id="mc" aria-label="Fazer carinho no mascote"><img src="${LOGO}" alt="Mascote: gato preto com óculos rosa e laço azul, sentado numa almofada rosa"></button></div>
  <h1>Achadinhos da Tech</h1><p>Sua loja fofa de setup: decoração e tecnologia escolhidas a dedo.</p>
  <div class="acts"><a class="btn" href="#/${keys[0]}">Ver achadinhos</a><button class="btn alt" id="pickbtn">🎲 Sortear um achadinho</button></div></section>
  <div id="pick"></div><div class="grid">`+keys.map(k=>{const p=PAGES[k];return `<a class="cat" href="#/${k}"><span class="em">${p.emoji}</span><h3>${p.title}</h3><span class="d">${p.desc}</span></a>`}).join('')+`</div>`;
  }
  function page(k){
    const p=PAGES[k];
    return `<div class="pagehead"><h1>${p.emoji} ${p.title}</h1><p>${p.desc}</p></div><div class="grid">`+
            (p.items.length?p.items.map(i=>card(i,p.color)).join(''):`<div class="about">Novos achadinhos chegando em breve! 🎀</div>`)+`</div>`;
  }
  function favPage(){
    const l=ALL.filter(x=>favs.has(x.i[3]));
    return `<div class="pagehead"><h1>💗 Meus favoritos</h1><p>Toque no coração dos produtos para guardar aqui.</p></div><div class="grid">`+
            (l.length?l.map(x=>card(x.i,x.c)).join(''):`<div class="about">Você ainda não favoritou nada. Que tal começar pelo <a href="#/${keys[0]}">Setup fofo</a>?</div>`)+`</div>`;
  }
  function about(){
    return `<div class="pagehead"><h1>💗 Sobre nós</h1></div>
  <div class="about sobre"><img src="${LOGO}" alt="Mascote da Achadinhos da Tech" class="sm">
  <div><p>Oi! Aqui é a <b>Achadinhos da Tech</b>, a loja fofa de setup. Eu garimpo na internet os melhores achadinhos de decoração e tecnologia, sempre com muito rosa, brilho e preço bom.</p>
  <p>Cada estilo tem a sua própria vitrine: setup fofo, My Melody, gadgets nerd e o que mais vier. Assim você vai direto para o que combina com o seu cantinho.</p>
  <p><b>Como funciona:</b> você escolhe o produto aqui e finaliza a compra na Shopee, com a segurança da própria loja. Ao comprar pelos nossos links, podemos receber uma pequena comissão, sem custo extra para você.</p>
  <p>Seja bem-vinda ao setup dos sonhos! 🎀</p></div></div>`;
  }
  function route(){
    const h=(location.hash.replace(/^#\/?/,'')||'');
    let cur='home',html;
    if(PAGES[h]){cur=h;html=page(h)} else if(h==='sobre'){cur='sobre';html=about()} else if(h==='favoritos'){cur='favoritos';html=favPage()} else html=home();
    $app.innerHTML=html; $nav.innerHTML=navHtml(cur);
    document.title=(cur==='home'?'':(PAGES[cur]?PAGES[cur].title:cur==='favoritos'?'Favoritos':'Sobre')+' · ')+'Achadinhos da Tech';
    window.scrollTo(0,0);
  }
  document.getElementById('av').src=AV;
  const PHR=["Miau! Hoje tem achadinho novo 🐾","Meus óculos rosa aprovam o seu setup 😎","Já favoritou os seus preferidos? 🤍","Ronron... esse teclado fofo é a minha cara ⌨️","Sorteia um achadinho comigo! 🎲","Setup bonito, dia produtivo 💗"];
  let pi=0;
  const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  let phraseTimer;
  function showPhrase(manual=false){
    const bub=document.getElementById('bub'); if(!bub)return;
    bub.textContent=PHR[pi++%PHR.length];
    bub.classList.remove('is-new'); void bub.offsetWidth; bub.classList.add('is-new');
    clearTimeout(phraseTimer);
    if(!manual) phraseTimer=setTimeout(()=>showPhrase(false),6500);
  }
  function burst(x,y){
    if(reduce)return;
    for(let n=0;n<7;n++){const h=document.createElement('span');h.className='heart';h.textContent=['💗','✨','🎀','💜'][n%4];
      h.style.left=x+'px';h.style.top=y+'px';h.style.setProperty('--dx',(Math.random()*120-60)+'px');
      document.body.appendChild(h);setTimeout(()=>h.remove(),1000);}
  }
  function toggle(id){
    favs.has(id)?favs.delete(id):favs.add(id); saveFavs();
    document.querySelectorAll('.fav').forEach(b=>{if(b.dataset.id===id){const on=favs.has(id);b.classList.toggle('on',on);b.textContent=on?'💗':'🤍';b.setAttribute('aria-pressed',on)}});
    document.getElementById('fc').textContent=favs.size;
    if(location.hash==='#/favoritos')route();
  }
  function pick(){
    const x=ALL[Math.floor(Math.random()*ALL.length)];
    document.getElementById('pick').innerHTML=`<div class="pickbox"><h2>Seu achadinho de hoje 🎲</h2><div class="one">${card(x.i,x.c)}</div></div>`;
  }
  document.addEventListener('click',e=>{
    const f=e.target.closest('.fav'); if(f){toggle(f.dataset.id); if(favs.has(f.dataset.id))burst(e.clientX,e.clientY); return}
    if(e.target.closest('#mc')){showPhrase(true);burst(e.clientX,e.clientY);return}
    if(e.target.closest('#pickbtn')){pick();burst(e.clientX,e.clientY)}
  });
  addEventListener('hashchange',route); route();
  setTimeout(()=>showPhrase(false),2200);
  document.getElementById('theme').onclick=()=>{
    const r=document.documentElement,d=r.dataset.theme==='dark'||(!r.dataset.theme&&matchMedia('(prefers-color-scheme:dark)').matches);
    r.dataset.theme=d?'light':'dark';
  };
</script>
</body>
</html>

